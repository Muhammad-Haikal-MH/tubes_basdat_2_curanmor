<%- include('../partials/header') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow rounded-4">
                <div class="card-body p-5">

                    <div class="text-center mb-5">
                        <h1 class="fw-bold">
                            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                            Form Laporan Kehilangan Motor
                        </h1>

                        <p class="text-muted">
                            Lengkapi data berikut untuk membantu proses pelaporan dan penyelidikan kendaraan hilang.
                        </p>
                    </div>

                    <form action="/laporan" method="POST" enctype="multipart/form-data">

                        <!-- DATA PELAPOR -->
                        <h4 class="fw-bold mb-3">Data Pelapor</h4>

                        <div class="mb-4">
                            <label class="form-label">Nama Pelapor</label>
                            <input type="text" class="form-control" name="nama_pelapor" required>
                        </div>

                        <!-- DATA KENDARAAN -->
                        <h4 class="fw-bold mb-3">Data Kendaraan</h4>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nomor Polisi</label>
                                <input type="text" class="form-control" name="plat_nomor" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nomor Rangka</label>
                                <input type="text" class="form-control" name="nomor_rangka" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nomor Mesin</label>
                                <input type="text" class="form-control" name="nomor_mesin" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Merk Motor</label>
                                <input type="text" class="form-control" name="merk_motor" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tipe Motor</label>
                                <input type="text" class="form-control" name="tipe_motor" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Warna Motor</label>
                                <input type="text" class="form-control" name="warna_motor" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Tahun Pembuatan</label>
                            <input type="number" class="form-control" name="tahun_pembuatan" required>
                        </div>

                        <!-- DATA KEPEMILIKAN -->
                        <h4 class="fw-bold mb-3">Data Kepemilikan</h4>

                        <div class="mb-3">
                            <label class="form-label">
                                Upload STNK (Wajib)
                            </label>
                            <input type="file" class="form-control" name="foto_stnk" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Upload BPKB (Opsional)
                            </label>
                            <input type="file" class="form-control" name="foto_bpkb">
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Surat Leasing (Jika BPKB di leasing)
                            </label>
                            <input type="file" class="form-control" name="surat_leasing">
                        </div>

                        <!-- DATA DIRI -->
                        <h4 class="fw-bold mb-3">Data Diri Pelapor</h4>

                        <div class="mb-4">
                            <label class="form-label">
                                Upload Foto KTP (Wajib)
                            </label>
                            <input type="file" class="form-control" name="foto_ktp" required>
                        </div>

                        <!-- KRONOLOGI -->
                        <h4 class="fw-bold mb-3">Kronologi & TKP</h4>

                        <div class="mb-3">
                            <label class="form-label">
                                Waktu Kejadian
                            </label>
                            <input type="datetime-local" class="form-control" name="waktu_kejadian" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Lokasi Kehilangan
                            </label>
                            <textarea class="form-control" name="lokasi_kehilangan" rows="3" required></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Kronologi Kehilangan
                            </label>
                            <textarea class="form-control" name="kronologi" rows="5" required></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Foto Kendaraan (Wajib)
                            </label>
                            <input type="file" class="form-control" name="foto_kendaraan" required>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Foto TKP / CCTV (Opsional)
                            </label>
                            <input type="file" class="form-control" name="foto_tkp">
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3">
                                <i class="bi bi-send-fill"></i>
                                Kirim Laporan
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/footer') %>