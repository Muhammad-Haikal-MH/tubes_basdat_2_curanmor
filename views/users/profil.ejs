<!doctype html>
<html lang="id">

<head>
  <%- include('../partials/header') %>
</head>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const oldPasswordInput = document.getElementById("old_password");
    const newPasswordField = document.getElementById("newPasswordField");

    if (!oldPasswordInput || !newPasswordField) return;

    oldPasswordInput.addEventListener("input", () => {
      if (oldPasswordInput.value.trim() !== "") {
        newPasswordField.style.display = "block";
      } else {
        newPasswordField.style.display = "none";
      }
    });
  });
</script>

<body>

  <div class="container py-5">

    <div class="row justify-content-center">

      <div class="col-lg-8">

        <div class="card border-0 shadow rounded-4">

          <div class="card-body p-5">

            <!-- Header -->
            <div class="text-center mb-5">

              <% if (user.avatar) { %>
                <img src="/uploads/<%= user.avatar %>" alt="Avatar" class="rounded-circle mb-3" style="width: 90px; height: 90px; object-fit: cover;">
              <% } else { %>
                <div
                  class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                  style="width: 90px; height: 90px; font-size: 2rem; font-weight: bold;">

                  <%= user.nama.charAt(0).toUpperCase() %>

                </div>
              <% } %>

              <h2 class="fw-bold mb-1">
                Profil Saya
              </h2>

              <p class="text-muted">
                Kelola informasi akun Anda
              </p>

            </div>

            <!-- Alert -->
            <% if (typeof message !=='undefined' && message) { %>

              <div class="alert alert-<%= message.type %>">
                <%= message.text %>
              </div>

              <% } %>

                <!-- Form -->
                <form method="POST" action="/profil/edit" enctype="multipart/form-data">

                  <!-- Nama -->
                  <div class="mb-4">

                    <label class="form-label fw-semibold">
                      Nama Lengkap
                    </label>

                    <input type="text" name="nama" class="form-control" value="<%= user.nama %>" required>

                  </div>

                  <!-- Email -->
                  <div class="mb-4">

                    <label class="form-label fw-semibold">
                      Email
                    </label>

                    <input type="email" class="form-control" value="<%= user.email %>" disabled>

                  </div>

                  <!-- Nomor HP -->
                  <div class="mb-4">

                    <label class="form-label fw-semibold">
                      Nomor HP
                    </label>

                    <input type="text" name="phone" class="form-control" value="<%= user.phone || '' %>"
                      placeholder="08xxxxxxxxxx">

                  </div>

                  <!-- Avatar -->
                  <div class="mb-4">

                    <label class="form-label fw-semibold">
                      Foto Profil
                    </label>

                    <% if (user.avatar) { %>
                      <div class="mb-3">
                        <img src="/uploads/<%= user.avatar %>" alt="Foto Profil Saat Ini" class="img-fluid rounded" style="max-width: 150px;">
                      </div>
                    <% } %>

                    <input type="file" name="avatar" class="form-control">
                    <div class="form-text">Unggah foto baru untuk mengganti avatar Anda.</div>

                  </div>

                  <!-- Buttons -->
                  <div class="d-flex gap-3">

                    <button class="btn btn-primary px-4">
                      <i class="bi bi-save me-2"></i>
                      Simpan Perubahan
                    </button>

                    <a href="/logout" class="btn btn-outline-danger px-4">

                      <i class="bi bi-box-arrow-right me-2"></i>
                      Logout

                    </a>

                  </div>

                </form>

          </div>
          <!-- CARD EDIT PASSWORD -->

        </div>
        <div class="card border-0 shadow rounded-4 mt-4">

          <div class="card-body p-5">

            <h4 class="fw-bold mb-4">
              <i class="bi bi-shield-lock me-2 text-primary"></i>
              Ubah Password
            </h4>

            <form method="POST" action="/profil/password">

              <!-- Password Lama -->
              <div class="mb-4">

                <label class="form-label fw-semibold">
                  Password Lama
                </label>

                <input type="password" name="old_password" class="form-control" placeholder="Masukkan password lama"
                  required>

              </div>

              <!-- Password Baru -->
              <div class="mb-4">

                <label class="form-label fw-semibold">
                  Password Baru
                </label>

                <input type="password" name="new_password" class="form-control" placeholder="Masukkan password baru"
                  required>

              </div>

              <!-- Konfirmasi Password -->
              <div class="mb-4">

                <label class="form-label fw-semibold">
                  Konfirmasi Password Baru
                </label>

                <input type="password" name="confirm_password" class="form-control" placeholder="Ulangi password baru"
                  required>

              </div>

              <!-- Button -->
              <button class="btn btn-primary">

                <i class="bi bi-key-fill me-2"></i>
                Simpan Password

              </button>

            </form>

          </div>

        </div>

      </div>

    </div>

  </div>

  <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>