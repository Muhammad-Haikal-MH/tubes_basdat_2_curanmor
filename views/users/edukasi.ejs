<%- include('../partials/header') %>

<div class="container py-5">

    <!-- HERO -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">
            <i class="bi bi-shield-check text-primary"></i>
            Edukasi Pencegahan Curanmor
        </h1>

        <p class="lead text-muted">
            Tingkatkan kewaspadaan dan lindungi kendaraan Anda dari tindak pencurian kendaraan bermotor.
        </p>
    </div>

    <!-- TIPS -->
    <style>
        .edu-card {
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        }
        .edu-card:hover,
        .edu-card:focus-visible {
            transform: translateY(-6px);
            box-shadow: 0 24px 60px rgba(13, 110, 253, 0.12);
            outline: none;
        }
        .edu-card a {
            color: inherit;
            text-decoration: none;
        }
        .edu-card .card-body {
            min-height: 240px;
        }
    </style>

    <div class="row g-4 mb-5">

        <div class="col-md-6">
            <div class="card border-0 shadow h-100 rounded-4 edu-card">
                <a href="/edukasi/ganda" class="d-block h-100 text-body">
                    <div class="card-body p-4">
                        <div class="mb-3 fs-1 text-primary">
                            <i class="bi bi-lock-fill"></i>
                        </div>
                        <h4 class="fw-bold">Gunakan Kunci Ganda</h4>
                        <p class="text-muted">
                            Selalu gunakan kunci tambahan atau alarm motor untuk mempersulit aksi pencurian.
                        </p>
                    </div>
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow h-100 rounded-4 edu-card">
                <a href="/edukasi/parkir" class="d-block h-100 text-body">
                    <div class="card-body p-4">
                        <div class="mb-3 fs-1 text-primary">
                            <i class="bi bi-lightbulb-fill"></i>
                        </div>
                        <h4 class="fw-bold">Parkir di Tempat Aman</h4>
                        <p class="text-muted">
                            Hindari parkir di tempat sepi dan minim pengawasan. Pilih area dengan CCTV atau penjaga parkir.
                        </p>
                    </div>
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow h-100 rounded-4 edu-card">
                <a href="/edukasi/gps" class="d-block h-100 text-body">
                    <div class="card-body p-4">
                        <div class="mb-3 fs-1 text-primary">
                            <i class="bi bi-camera-video-fill"></i>
                        </div>
                        <h4 class="fw-bold">Pasang GPS atau CCTV</h4>
                        <p class="text-muted">
                            Gunakan GPS tracker atau CCTV untuk membantu pelacakan kendaraan jika terjadi kehilangan.
                        </p>
                    </div>
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow h-100 rounded-4 edu-card">
                <a href="/edukasi/dokumen" class="d-block h-100 text-body">
                    <div class="card-body p-4">
                        <div class="mb-3 fs-1 text-primary">
                            <i class="bi bi-file-earmark-text-fill"></i>
                        </div>
                        <h4 class="fw-bold">Simpan Dokumen Kendaraan</h4>
                        <p class="text-muted">
                            Pastikan STNK dan BPKB disimpan dengan aman dan memiliki salinan digital untuk kebutuhan laporan.
                        </p>
                    </div>
                </a>
            </div>
        </div>

    </div>

    <!-- LANGKAH SAAT KEHILANGAN -->
    <div class="card border-0 shadow rounded-4 mb-5">
        <div class="card-body p-5">

            <h2 class="fw-bold mb-4">
                <i class="bi bi-exclamation-circle-fill text-danger"></i>
                Apa yang Harus Dilakukan Saat Motor Hilang?
            </h2>

            <div class="row g-4">

                <div class="col-md-3">
                    <div class="text-center">
                        <div class="fs-1 text-primary mb-3">
                            <i class="bi bi-search"></i>
                        </div>

                        <h5 class="fw-bold">Cari Informasi</h5>

                        <p class="text-muted small">
                            Periksa area sekitar dan tanyakan kepada saksi di lokasi kejadian.
                        </p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="text-center">
                        <div class="fs-1 text-primary mb-3">
                            <i class="bi bi-camera"></i>
                        </div>

                        <h5 class="fw-bold">Kumpulkan Bukti</h5>

                        <p class="text-muted small">
                            Simpan rekaman CCTV, foto TKP, atau bukti lain yang tersedia.
                        </p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="text-center">
                        <div class="fs-1 text-primary mb-3">
                            <i class="bi bi-pencil-square"></i>
                        </div>

                        <h5 class="fw-bold">Buat Laporan</h5>

                        <p class="text-muted small">
                            Laporkan kehilangan melalui LaMo atau kantor polisi terdekat.
                        </p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="text-center">
                        <div class="fs-1 text-primary mb-3">
                            <i class="bi bi-broadcast"></i>
                        </div>

                        <h5 class="fw-bold">Sebarkan Informasi</h5>

                        <p class="text-muted small">
                            Sebarkan informasi kendaraan hilang untuk membantu proses pencarian.
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- CTA -->
    <div class="text-center py-4">
        <h3 class="fw-bold mb-3">
            Kehilangan Kendaraan?
        </h3>

        <p class="text-muted mb-4">
            Segera buat laporan kehilangan kendaraan agar dapat diproses lebih cepat.
        </p>

        <a href="/laporan" class="btn btn-primary btn-lg px-5 rounded-3">
            <i class="bi bi-pencil-square"></i>
            Buat Laporan
        </a>
    </div>

</div>

<%- include('../partials/footer') %>