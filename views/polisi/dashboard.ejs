<%- include('../partials/dashboardHeader') %>

<%- include('../partials/dashboardSidebar') %>

<div class="main-content">

  <div class="topbar p-3 d-flex justify-content-between align-items-center">
    <h4 class="mb-0 fw-bold">
      Dashboard Polisi
    </h4>
    <div class="d-flex align-items-center gap-3">
      <i class="bi bi-shield-check fs-5"></i>
      <div class="fw-semibold">
        Polisi
      </div>
    </div>
  </div>

  <div class="row mb-4 p-4">

    <!-- Total -->
    <div class="col-md-3">
      <a href="/polisi" class="text-decoration-none">
        <div class="card shadow-sm border-0 rounded-4">
          <div class="card-body">
            <h6 class="text-muted">Total Laporan</h6>
            <h2 class="fw-bold text-dark">
              <%= totalLaporan %>
            </h2>
          </div>
        </div>
      </a>
    </div>

    <!-- Diproses -->
    <div class="col-md-3">
      <a href="/polisi?status=diproses" class="text-decoration-none">
        <div class="card shadow-sm border-0 rounded-4">
          <div class="card-body">
            <h6 class="text-muted">Laporan Diproses</h6>
            <h2 class="fw-bold text-warning">
              <%= totalDiproses %>
            </h2>
          </div>
        </div>
      </a>
    </div>

    <!-- Ditemukan -->
    <div class="col-md-3">
      <a href="/polisi?status=ditemukan" class="text-decoration-none">
        <div class="card shadow-sm border-0 rounded-4">
          <div class="card-body">
            <h6 class="text-muted">Laporan Ditemukan</h6>
            <h2 class="fw-bold text-primary">
              <%= totalDitemukan %>
            </h2>
          </div>
        </div>
      </a>
    </div>

    <!-- Selesai -->
    <div class="col-md-3">
      <a href="/polisi?status=selesai" class="text-decoration-none">
        <div class="card shadow-sm border-0 rounded-4">
          <div class="card-body">
            <h6 class="text-muted">Laporan Selesai</h6>
            <h2 class="fw-bold text-success">
              <%= totalSelesai %>
            </h2>
          </div>
        </div>
      </a>
    </div>

  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
      <h5 class="fw-bold mb-4">
        Data Laporan Diproses
      </h5>

      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>

              <th>Tanggal</th>

              <th>Pelapor</th>
              <th>Kendaraan</th>
              <th>Status</th>
              <th>Aksi</th>
              <th>Surat</th>
            </tr>
          </thead>

          <tbody>
            <% laporan.forEach((item)=> { %>
            <tr>
              <td>
                <%= new Date(item.createdAt).toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                  }) %>
              <td>
                <%= item.nama_pelapor %>
              </td>

              <td>
                <%= item.merk_motor %>
                <%= item.tipe_motor %>
              </td>

              <td>
                <% if(item.status==="diproses" ) { %>
                <span class="badge bg-warning text-dark">
                  Diproses
                </span>
                <% } %>

                <% if(item.status==="ditemukan" ) { %>
                <span class="badge bg-primary">
                  Ditemukan
                </span>
                <% } %>

                <% if(item.status==="selesai" ) { %>
                <span class="badge bg-success">
                  Selesai
                </span>
                <% } %>
              </td>

              <td class="d-flex gap-2 flex-wrap">
                <a href="/polisi/laporan/<%= item._id %>" class="btn btn-sm btn-info text-white">
                  Detail
                </a>
                <% if(item.status==="diproses" ) { %>
                <form action="/polisi/laporan/<%= item._id %>/status" method="POST">
                  <input type="hidden" name="status" value="ditemukan">
                  <button class="btn btn-sm btn-primary ">
                    Ditemukan
                  </button>
                </form>

                <% } %>

                <% if(item.status==="ditemukan" ) { %>
                <form action="/polisi/laporan/<%= item._id %>/status" method="POST">
                  <input type="hidden" name="status" value="selesai">
                  <button class="btn btn-sm btn-success">
                    Selesai
                  </button>
                </form>
                <% } %>
                <% if(item.status==="selesai" ) { %>
                <button class="btn btn-sm btn-secondary" disabled>
                  Sudah Selesai
                </button>
                <% } %>
              </td>
              <td>

                <% if(item.status==="diproses" ) { %>

                <% if(!item.bap_selesai) { %>

                <a href="/polisi/form_bap/<%= item._id %>" class="btn btn-sm btn-warning">

                  <i class="bi bi-file-earmark-plus"></i>
                  Buat STPL

                </a>

                <% } else { %>

                <a href="/polisi/surat/bap/<%= item._id %>" class="btn btn-sm btn-outline-warning">

                  <i class="bi bi-printer"></i>
                  Cetak STPL

                </a>

                <% } %>

                <% } else if(item.status==="ditemukan" ) { %>

                <% if(!item.bast_selesai) { %>

                <a href="/polisi/form_bast/<%= item._id %>" class="btn btn-sm btn-primary">

                  <i class="bi bi-file-earmark-check"></i>
                  Buat BAST

                </a>

                <% } else { %>

                <a href="/polisi/surat/bast/<%= item._id %>" class="btn btn-sm btn-outline-primary">

                  <i class="bi bi-printer"></i>
                  Cetak BAST

                </a>

                <% } %>

                <% } else if(item.status==="ditemukan" ) {
                                                                                    %>

                <a href="/polisi/surat/bast/<%= item._id %>" class="btn btn-sm btn-outline-success">

                  <i class="bi bi-printer"></i>
                  Cetak BAST

                </a>

                <% } else { %>

                <span class="text-muted">-</span>

                <% } %>

              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</div>

<%- include('../partials/dashboardFooter') %>